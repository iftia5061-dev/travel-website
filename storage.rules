rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is admin
    function isAdmin() {
      let adminEmails = [
        'admin@travelwebsite.com',
      ];
      return request.auth != null && adminEmails.contains(request.auth.token.email);
    }

    // Tour images
    match /tours/{tourId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Hotel images
    match /hotels/{hotelId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Destination images
    match /destinations/{destinationId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profile images
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Visa documents - only admin can read/write
    match /visa-documents/{applicationId}/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Hajj/Umrah images
    match /hajj-umrah/{packageId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
